PORT=4000
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo backend. Nunca exponer en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Tiempo máximo de cada llamada a Supabase (ms). Si se agota, el backend responde 503 en vez de
# dejar la petición colgada. Las llamadas normales tardan 0,1-0,6 s en producción.
SUPABASE_TIMEOUT_MS=8000

# Ejecutor de código Java:
#  - local: SOLO desarrollo (el backend se niega a arrancar con local en producción).
#  - contenedor: producción, dentro de la imagen Docker del backend (backend/Dockerfile, Render).
RUNNER=local
# JDK 17 (el ejecutor depende del Security Manager, eliminado desde Java 24)
JAVA_HOME=
# Solo para RUNNER=contenedor: usuario Linux (uid/gid) que corre el código del estudiante, DISTINTO
# del usuario del backend. Ya quedan fijos en backend/Dockerfile (10001/10001); no hace falta tocarlos.
RUNNER_SANDBOX_UID=
RUNNER_SANDBOX_GID=
# Solo para RUNNER=contenedor: true = si el usuario sandbox no funciona en la plataforma, seguir solo
# con la Guardia en vez de no arrancar (Render lo necesita; ya va en el Dockerfile).
RUNNER_PERMITIR_SIN_SANDBOX=false
RUNNER_CONCURRENCIA=2
# Límites ajustables según la CPU del servidor (valores de Render en render.yaml).
RUNNER_CASOS_EN_PARALELO=3
RUNNER_COMPILACION_MS=10000
RUNNER_EJECUCION_MS=3000
