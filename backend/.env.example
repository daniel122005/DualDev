PORT=4000
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo backend. Nunca exponer en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Ejecutor de código Java:
#  - local: SOLO desarrollo (el backend se niega a arrancar con local en producción).
#  - contenedor: producción, dentro de la imagen Docker del backend (backend/Dockerfile, Render).
RUNNER=local
# JDK 17 (el ejecutor depende del Security Manager, eliminado desde Java 24)
JAVA_HOME=
RUNNER_CONCURRENCIA=2
# Límites ajustables según la CPU del servidor (valores de Render en render.yaml).
RUNNER_CASOS_EN_PARALELO=3
RUNNER_COMPILACION_MS=10000
RUNNER_EJECUCION_MS=3000
