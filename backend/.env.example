PORT=4000
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo backend. Nunca exponer en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Ejecutor de código Java. RUNNER=local SOLO en desarrollo (el backend se niega a arrancar con local en producción).
RUNNER=local
# JDK 17 (el ejecutor local depende del Security Manager, eliminado desde Java 24)
JAVA_HOME=
RUNNER_CONCURRENCIA=2
